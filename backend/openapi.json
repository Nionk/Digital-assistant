{
  "openapi": "3.1.0",
  "info": {
    "title": "SKART AI Assistant API",
    "description": "Двухконтурный сервис мониторинга деловых мероприятий и пакетного подбора под бюджет компании для ГК «СКАРТ». Включает закрытый кабинет менеджера (/api/manager/*) и интерактивную публичную витрину клиента (/api/public/s/*) с изолированным RAG-чатом по регламентам.",
    "version": "0.1.0-demo"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Health Check",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/manager/clients": {
      "get": {
        "tags": [
          "Manager Cabinet"
        ],
        "summary": "Список клиентов менеджера и алерты горящих дедлайнов Early Bird",
        "description": "Возвращает список закрепленных за менеджером клиентов со статусами их последних подборок и панель срочных алертов по мероприятиям с активными скидками раннего бронирования (Early Bird).",
        "operationId": "get_manager_clients_api_manager_clients_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ManagerDashboardOut"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/manager/clients/{client_id}/match": {
      "post": {
        "tags": [
          "Manager Cabinet"
        ],
        "summary": "Извлечение профиля из заметки (NER), сборка 2 вариантов пакетов и генерация черновика КП",
        "description": "Выполняет полный цикл интеллектуального подбора (D-06 + D-07): извлекает параметры из сырой заметки, ранжирует кандидатов через гибридный поиск (pgvector + FTS RRF), собирает 2 варианта пакета и бонусный слот 'Цена по запросу', генерирует текст КП и сохраняет черновик в БД.",
        "operationId": "match_events_for_client_api_manager_clients__client_id__match_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "client_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Client Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MatchRequestIn"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MatchResponseOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/manager/selections/{selection_id}/publish": {
      "put": {
        "tags": [
          "Manager Cabinet"
        ],
        "summary": "Фиксация выбранного пакета, сохранение текста КП и выпуск публичной ссылки Magic Link",
        "description": "Атомарно фиксирует утвержденный менеджером вариант пакета, удаляет альтернативный черновик, валидирует связки (event_id, tariff_id), переводит статус подборки в 'published' и возвращает уникальный UUIDv4 токен витрины.",
        "operationId": "publish_selection_api_manager_selections__selection_id__publish_put",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "selection_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Selection Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PublishSelectionIn"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublishSelectionOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/public/s/{magic_token}": {
      "get": {
        "tags": [
          "Client Public Showcase (Magic Link)"
        ],
        "summary": "Получение персональной витрины клиента по защищенной ссылке Magic Link",
        "description": "Публичный маршрут без авторизации. Доступ осуществляется строго по криптостойкому UUIDv4 токену. Возвращает сопроводительное письмо, сводную плашку бюджета, карточки мероприятий и чипсы быстрых вопросов FAQ.",
        "operationId": "get_public_showcase_api_public_s__magic_token__get",
        "parameters": [
          {
            "name": "magic_token",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Magic Token"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShowcaseViewOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/public/s/{magic_token}/items/{item_id}/react": {
      "post": {
        "tags": [
          "Client Public Showcase (Magic Link)"
        ],
        "summary": "Фиксация реакции клиента на карточку события и мгновенный пуш менеджеру в Telegram",
        "description": "Сохраняет реакцию клиента ('interested' 👍 или 'rejected' 👎) и опциональный комментарий, проверяя принадлежность карточки указанному magic_token (защита от IDOR), и отправляет уведомление персональному менеджеру в Telegram.",
        "operationId": "react_to_showcase_item_api_public_s__magic_token__items__item_id__react_post",
        "parameters": [
          {
            "name": "magic_token",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Magic Token"
            }
          },
          {
            "name": "item_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Item Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClientReactionIn"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientReactionOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/public/s/{magic_token}/events/{event_id}/ask": {
      "post": {
        "tags": [
          "Client Public Showcase (Magic Link)"
        ],
        "summary": "Изолированный RAG-ответ клиенту по регламенту конкретного события или эскалация в Telegram",
        "description": "Принимает вопрос клиента по конкретному мероприятию пакета. Если ответ присутствует в регламенте, возвращает подтвержденный факт с цитатой. Если данных нет, фиксирует обращение в chat_messages и эскалирует вопрос в Telegram персональному менеджеру.",
        "operationId": "ask_event_regulation_question_api_public_s__magic_token__events__event_id__ask_post",
        "parameters": [
          {
            "name": "magic_token",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Magic Token"
            }
          },
          {
            "name": "event_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Event Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AskRegulationQuestionIn"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AskRegulationQuestionOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AskRegulationQuestionIn": {
        "properties": {
          "question_text": {
            "type": "string",
            "maxLength": 500,
            "minLength": 3,
            "title": "Question Text",
            "description": "Текст вопроса клиента или текст выбранного быстрого чипса",
            "examples": [
              "Что входит в рекомендованный тариф?"
            ]
          }
        },
        "type": "object",
        "required": [
          "question_text"
        ],
        "title": "AskRegulationQuestionIn",
        "description": "Вопрос клиента по регламенту конкретного мероприятия."
      },
      "AskRegulationQuestionOut": {
        "properties": {
          "event_id": {
            "type": "integer",
            "title": "Event Id",
            "description": "ID мероприятия"
          },
          "question_text": {
            "type": "string",
            "title": "Question Text",
            "description": "Исходный вопрос клиента"
          },
          "is_answer_found": {
            "type": "boolean",
            "title": "Is Answer Found",
            "description": "True — точный ответ найден в тексте программы; False — информации нет, вопрос эскалирован менеджеру"
          },
          "answer_text": {
            "type": "string",
            "title": "Answer Text",
            "description": "Сформулированный ответ ИИ по регламенту либо вежливое уведомление о передаче вопроса менеджеру"
          },
          "source_quote": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Quote",
            "description": "Цитата из официального регламента, подтверждающая ответ (защита от галлюцинаций)"
          },
          "from_cache": {
            "type": "boolean",
            "title": "From Cache",
            "description": "True, если ответ получен мгновенно из PostgreSQL таблицы llm_cache",
            "default": false
          },
          "escalated_to_telegram": {
            "type": "boolean",
            "title": "Escalated To Telegram",
            "description": "True, если неотвеченный вопрос отправлен в виде пуша в Telegram менеджеру",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "event_id",
          "question_text",
          "is_answer_found",
          "answer_text"
        ],
        "title": "AskRegulationQuestionOut",
        "description": "Ответ ИИ-ассистента по регламенту события (изолированный RAG)."
      },
      "BundleEventItemOut": {
        "properties": {
          "event_id": {
            "type": "integer",
            "title": "Event Id",
            "description": "ID события в таблице events"
          },
          "canonical_title": {
            "type": "string",
            "title": "Canonical Title",
            "description": "Официальное название форума/сессии"
          },
          "event_format": {
            "type": "string",
            "enum": [
              "roundtable",
              "business_breakfast",
              "forum",
              "conference",
              "session"
            ],
            "title": "Event Format",
            "description": "Формат проведения"
          },
          "city": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "City",
            "description": "Город проведения в именительном падеже (None, если строго онлайн)"
          },
          "is_online": {
            "type": "boolean",
            "title": "Is Online",
            "description": "Признак онлайн-формата мероприятия",
            "default": false
          },
          "venue": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Venue",
            "description": "Площадка, отель, адрес или платформа трансляции"
          },
          "start_date": {
            "type": "string",
            "format": "date",
            "title": "Start Date",
            "description": "Дата начала (YYYY-MM-DD)"
          },
          "end_date": {
            "type": "string",
            "format": "date",
            "title": "End Date",
            "description": "Дата окончания (YYYY-MM-DD)"
          },
          "themes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Themes",
            "description": "Список отраслевых тегов"
          },
          "recommended_tariff": {
            "$ref": "#/components/schemas/TariffOptionOut",
            "description": "Тариф, рассчитанный алгоритмом в рамках бюджета"
          },
          "available_tariffs": {
            "items": {
              "$ref": "#/components/schemas/TariffOptionOut"
            },
            "type": "array",
            "title": "Available Tariffs",
            "description": "Все тарифы события, позволяющие менеджеру вручную переключить роль в UI"
          },
          "ai_rationale": {
            "type": "string",
            "title": "Ai Rationale",
            "description": "Обоснование ИИ, какую конкретно бизнес-задачу клиента решает данное мероприятие"
          }
        },
        "type": "object",
        "required": [
          "event_id",
          "canonical_title",
          "event_format",
          "start_date",
          "end_date",
          "recommended_tariff",
          "ai_rationale"
        ],
        "title": "BundleEventItemOut",
        "description": "Мероприятие, предложенное в составе пакета."
      },
      "BundleVariantOut": {
        "properties": {
          "bundle_group": {
            "type": "integer",
            "title": "Bundle Group",
            "description": "1 — Максимальное совпадение по темам (RRF), 2 — Оптимальный по экономии бюджета"
          },
          "bundle_title": {
            "type": "string",
            "title": "Bundle Title",
            "description": "Заголовок пакета для вкладки в интерфейсе менеджера"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/BundleEventItemOut"
            },
            "type": "array",
            "title": "Items",
            "description": "Список мероприятий пакета"
          },
          "total_actual_price": {
            "type": "number",
            "title": "Total Actual Price",
            "description": "Итоговая актуальная стоимость всего пакета в рублях"
          },
          "total_base_price": {
            "type": "number",
            "title": "Total Base Price",
            "description": "Стоимость пакета без учета скидок раннего бронирования"
          },
          "total_savings": {
            "type": "number",
            "title": "Total Savings",
            "description": "Суммарная экономия по скидкам Early Bird в рублях"
          },
          "earliest_deadline": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Earliest Deadline",
            "description": "Ближайшая дата сгорания скидки среди событий пакета"
          },
          "is_over_budget_tolerance": {
            "type": "boolean",
            "title": "Is Over Budget Tolerance",
            "description": "True, если пакет превышает бюджет клиента в пределах допустимых +10% (требует согласования)",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "bundle_group",
          "bundle_title",
          "items",
          "total_actual_price",
          "total_base_price",
          "total_savings"
        ],
        "title": "BundleVariantOut",
        "description": "Один из сгенерированных вариантов пакета мероприятий."
      },
      "BurningDeadlineOut": {
        "properties": {
          "event_id": {
            "type": "integer",
            "title": "Event Id",
            "description": "ID мероприятия в БД"
          },
          "event_title": {
            "type": "string",
            "title": "Event Title",
            "description": "Каноническое название мероприятия"
          },
          "early_bird_deadline": {
            "type": "string",
            "format": "date",
            "title": "Early Bird Deadline",
            "description": "Дата сгорания скидки Early Bird"
          },
          "potential_savings": {
            "type": "number",
            "title": "Potential Savings",
            "description": "Сумма потери скидки в рублях при пропуске дедлайна"
          }
        },
        "type": "object",
        "required": [
          "event_id",
          "event_title",
          "early_bird_deadline",
          "potential_savings"
        ],
        "title": "BurningDeadlineOut",
        "description": "Информация о горящем дедлайне со скидкой Early Bird (< 72 часов)."
      },
      "ClientQueryExtracted": {
        "properties": {
          "cities": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Cities",
            "description": "Канонические названия городов проведения"
          },
          "include_online": {
            "type": "boolean",
            "title": "Include Online",
            "description": "Включать ли онлайн-мероприятия (вебинары, трансляции)",
            "default": true
          },
          "date_from": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Date From",
            "description": "Начало периода поиска (YYYY-MM-DD)"
          },
          "date_to": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Date To",
            "description": "Конец периода поиска (YYYY-MM-DD)"
          },
          "total_budget_max": {
            "type": "number",
            "title": "Total Budget Max",
            "description": "Общий потолок бюджета на всю серию в рублях"
          },
          "target_events_count": {
            "type": "integer",
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Target Events Count",
            "description": "Желаемое число событий в пакете",
            "default": 3
          },
          "preferred_formats": {
            "items": {
              "type": "string",
              "enum": [
                "roundtable",
                "business_breakfast",
                "forum",
                "conference",
                "session"
              ]
            },
            "type": "array",
            "title": "Preferred Formats",
            "description": "Предпочтительные форматы деловых событий"
          },
          "required_roles": {
            "items": {
              "type": "string",
              "enum": [
                "delegate",
                "speaker",
                "sponsor"
              ]
            },
            "type": "array",
            "title": "Required Roles",
            "description": "Требуемые форматы участия"
          },
          "min_speaker_events": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 0.0,
            "title": "Min Speaker Events",
            "description": "На скольких событиях минимум клиент хочет выступить спикером",
            "default": 0
          },
          "themes_keywords": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Themes Keywords",
            "description": "Ключевые отраслевые теги (КРТ, ИЖС, урбанистика, цифровизация)"
          },
          "semantic_search_query": {
            "type": "string",
            "title": "Semantic Search Query",
            "description": "Развернутый поисковый запрос для векторного поиска (pgvector cosine ops)"
          }
        },
        "type": "object",
        "required": [
          "total_budget_max",
          "semantic_search_query"
        ],
        "title": "ClientQueryExtracted",
        "description": "Схема извлечения параметров из свободной заметки менеджера (NER-профайлер).\nПолностью совпадает с контрактом модуля profiler.py."
      },
      "ClientReactionIn": {
        "properties": {
          "reaction": {
            "type": "string",
            "enum": [
              "interested",
              "rejected"
            ],
            "title": "Reaction",
            "description": "Реакция: interested (Интересно) или rejected (Заменить/Отклонить)"
          },
          "comment": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
