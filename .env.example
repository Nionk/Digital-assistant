# Runtime Environment: prod (по умолчанию) или dev
ENVIRONMENT=prod
APP_TIMEZONE=Europe/Moscow
ENABLE_SCHEDULER=false

POSTGRES_USER=scart_admin
POSTGRES_PASSWORD=scart_secret_password
POSTGRES_DB=scart_db
DATABASE_URL=postgresql+asyncpg://scart_admin:scart_secret_password@localhost:5432/scart_db

# Security & JWT (Валидный ключ для dev-старта; ОБЯЗАТЕЛЬНО замените в prod: openssl rand -hex 32)
SECRET_KEY=4f8a9c2e1b7d6f3a5c8e0b2d4f6a8c0e2b4d6f8a0c2e4b6d8f0a2c4e6b8d0f2a
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOW_DEMO_AUTH_BYPASS=false

# LLM Gateway (OpenRouter / Ru-OpenRouter)
LLM_API_KEY=
LLM_BASE_URL=https://api.ru-openrouter.ru/v1
LLM_MODEL=deepseek/deepseek-chat

# Jina Reader & Embedding Gateway (Jina AI)
JINA_API_KEY=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.jina.ai/v1
EMBEDDING_MODEL=jina-embeddings-v3
EMBEDDING_DIM=1024

# Telegram Alerts (Bot API)
TELEGRAM_BOT_TOKEN=
TELEGRAM_MANAGER_CHAT_ID=
