POSTGRES_USER=scart_admin
POSTGRES_PASSWORD=scart_secret_password
POSTGRES_DB=scart_db
DATABASE_URL=postgresql+asyncpg://scart_admin:scart_secret_password@db:5432/scart_db

# Security
SECRET_KEY=super_secret_key_for_jwt_change_me_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Gateway (OpenRouter / Ru-OpenRouter)
LLM_API_KEY=
LLM_BASE_URL=https://api.ru-openrouter.ru/v1
LLM_MODEL=deepseek/deepseek-v4.1-flash

# Embedding Gateway (Jina AI)
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.jina.ai/v1
EMBEDDING_MODEL=jina-embeddings-v5-omni-small
EMBEDDING_DIM=1024
